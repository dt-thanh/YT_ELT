# =============================================================================
# MẪU CẤU HÌNH - copy thành .env rồi điền giá trị thật:  cp .env.example .env
#
# File NÀY được commit lên git. File .env thì KHÔNG (đã có trong .gitignore).
# Vì sao cần cả hai? .env bị ẩn khỏi git nên người clone repo về không biết
# cần những biến gì -> chạy docker compose up là lỗi khó hiểu. File này là
# "hợp đồng cấu hình": liệt kê đủ TÊN biến, không có GIÁ TRỊ thật.
#
# QUY TẮC: không bao giờ điền secret thật vào đây.
# =============================================================================

# --- Image trên DockerHub (CI build và push vào đây) -------------------------
DOCKERHUB_NAMESPACE=<tên tài khoản dockerhub>
DOCKERHUB_REPOSITORY=<tên repository>
IMAGE_TAG=latest

# --- Postgres: tài khoản siêu quyền của container ---------------------------
# POSTGRES_CONN_HOST là TÊN SERVICE trong docker-compose, không phải localhost.
POSTGRES_CONN_USERNAME=postgres
POSTGRES_CONN_PASSWORD=<đặt mật khẩu>
POSTGRES_CONN_HOST=postgres
POSTGRES_CONN_PORT=5432

# --- Database 1/3: metadata của Airflow (lịch sử chạy, XCom, connection) ----
METADATA_DATABASE_NAME=airflow_metadata
METADATA_DATABASE_USERNAME=<user>
METADATA_DATABASE_PASSWORD=<mật khẩu>

# --- Database 2/3: Celery result backend ------------------------------------
# CHỈ cần khi dùng CeleryExecutor. Dự án đang dùng LocalExecutor nên không dùng
# tới, nhưng script init vẫn tạo sẵn database này -> giữ biến để script chạy được.
CELERY_BACKEND_NAME=airflow_celery
CELERY_BACKEND_USERNAME=<user>
CELERY_BACKEND_PASSWORD=<mật khẩu>

# --- Database 3/3: kho dữ liệu thật của project -----------------------------
ELT_DATABASE_NAME=elt_db
ELT_DATABASE_USERNAME=<user>
ELT_DATABASE_PASSWORD=<mật khẩu>

# --- Airflow ----------------------------------------------------------------
# AIRFLOW_UID: lấy bằng lệnh  id -u   (để file log/dags không bị root chiếm quyền)
AIRFLOW_UID=50000
AIRFLOW_WWW_USER_USERNAME=airflow
AIRFLOW_WWW_USER_PASSWORD=<mật khẩu đăng nhập web UI>
# FERNET_KEY: khóa mã hóa Connection/Variable lưu trong metadata db. Sinh bằng:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=<chuỗi fernet 44 ký tự>

# --- YouTube Data API v3 ----------------------------------------------------
# Lấy tại console.cloud.google.com -> APIs & Services -> Credentials -> API key.
# NHỚ: bật "YouTube Data API v3" trong Library, và Restrict key về đúng API đó.
API_KEY=<API key Google, bắt đầu bằng AIza, 39 ký tự>
CHANNEL_HANDLE=MrBeast
# CHANNEL_ID bền vững hơn handle (chủ kênh đổi handle được, đổi ID thì không).
CHANNEL_ID=

# --- MinIO: data lake S3-compatible -----------------------------------------
# endpoint dùng TÊN SERVICE "minio" vì code chạy TRONG container airflow;
# ở đó "localhost" là chính container airflow, không phải máy bạn.
# Muốn truy cập từ máy thật (trình duyệt, script ngoài docker) thì dùng
# http://localhost:9000 - đây là hai góc nhìn mạng khác nhau, đừng lẫn.
# MINIO_SECRET_KEY phải dài tối thiểu 8 ký tự (yêu cầu của MinIO).
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=<tên đăng nhập minio>
MINIO_SECRET_KEY=<mật khẩu minio, >= 8 ký tự>
